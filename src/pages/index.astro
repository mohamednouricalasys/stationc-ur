---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ObjectiveCard from '../components/ObjectiveCard.astro';
import PlatformRow from '../components/PlatformRow.astro';
import PublicCard from '../components/PublicCard.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import Gallery from '../components/Gallery.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ContactSection from '../components/ContactSection.astro';
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Icons for objectives
const objectiveIcons = [
  `<svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>`,
  `<svg class="w-7 h-7 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>`,
  `<svg class="w-7 h-7 text-warm-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>`,
  `<svg class="w-7 h-7 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>`,
];

const objectiveColors = ['primary', 'accent', 'warm', 'secondary'] as const;

// Icons for publics
const publicIcons = [
  `<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>`,
  `<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>`,
  `<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>`,
  `<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>`,
];

const publicColors = ['primary', 'accent', 'warm', 'secondary'] as const;

const partners = [
  { name: "Région Île-de-France", logo: `${base}/images/partners/partner-10.webp`, url: "https://www.iledefrance.fr" },
  { name: "SNCF", logo: `${base}/images/partners/partner-08.webp`, url: "https://www.sncf.com" },
  { name: "Île-de-France Mobilités", logo: `${base}/images/partners/partner-09.webp`, url: "https://www.iledefrance-mobilites.fr" },
  { name: "Malakoff Humanis", logo: `${base}/images/partners/partner-11.webp`, url: "https://www.malakoffhumanis.com" },
  { name: "L'assurance retraite", logo: `${base}/images/partners/partner-12.webp`, url: "https://www.lassuranceretraite.fr" },
  { name: "BGE", logo: `${base}/images/partners/partner-05.webp`, url: "https://www.bge.asso.fr" },
  { name: "Le Quai des Possibles", logo: `${base}/images/partners/partner-06.webp`, url: "https://lequaidespossibles.fr" }
];

const galleryItems = [
  { src: `${base}/images/gallery/gallery-39.webp`, alt: lang === 'fr' ? "L'équipe devant la boutique solidaire" : "The team in front of the solidarity shop", caption: lang === 'fr' ? "L'équipe Station-Cœur" : "The Station-Cœur team" },
  { src: `${base}/images/gallery/gallery-28.webp`, alt: lang === 'fr' ? "Terrasse devant la gare" : "Terrace in front of the station", caption: lang === 'fr' ? "La terrasse de la gare" : "The station terrace" },
  { src: `${base}/images/gallery/gallery-34.webp`, alt: lang === 'fr' ? "Bénévoles et partenaires devant la gare" : "Volunteers and partners in front of the station", caption: lang === 'fr' ? "Bénévoles et partenaires" : "Volunteers and partners" },
  { src: `${base}/images/gallery/gallery-26.webp`, alt: lang === 'fr' ? "Boutique de vêtements de seconde main" : "Second-hand clothing shop", caption: lang === 'fr' ? "La boutique solidaire" : "The solidarity shop" },
  { src: `${base}/images/gallery/gallery-21.webp`, alt: lang === 'fr' ? "Rencontre sur le parvis de la gare" : "Meeting on the station forecourt", caption: lang === 'fr' ? "Rencontres en gare" : "Meetings at the station" },
  { src: `${base}/images/gallery/gallery-40.webp`, alt: lang === 'fr' ? "Moment de partage entre participantes" : "A shared moment between participants", caption: lang === 'fr' ? "Moments de partage" : "Shared moments" }
];

// « Le chantier »: station photos shown as polaroids (same order as t.presentation.photos)
const stationPhotos = [
  `${base}/images/activities/activity-10.webp`,
  `${base}/images/activities/activity-13.webp`,
  `${base}/images/activities/activity-11.webp`,
];
// Staggered so each photo only overlaps the edge of the previous one and every caption stays visible
const polaroidLayout = [
  'left-0 top-0 w-[56%] -rotate-[4deg]',
  'right-0 top-[20%] w-[52%] rotate-[4deg]',
  'left-[8%] bottom-0 w-[50%] -rotate-[2deg]',
];

// « Notre cap »: one colour per line, dark enough to carry a white numeral
const lineColors = ['bg-primary-600', 'bg-accent-700', 'bg-warm-700'];

// « Le lieu »: one image per platform (same order as t.activities.items); undefined shows the icon tile
const platformImages = [
  `${base}/images/gallery/gallery-14.webp`,
  `${base}/images/activities/activity-24.webp`,
  `${base}/images/gallery/gallery-16.webp`,
  `${base}/images/gallery/gallery-17.webp`,
  `${base}/images/activities/activity-29.webp`,
  undefined,
  `${base}/images/activities/activity-04.webp`,
];
---

<MainLayout title="Station-Cœur | Nous Avons Des Elles">
  <!-- Hero Section -->
  <Hero lang={lang} />

  <!-- Le chantier Section -->
  <section id="chantier" class="py-20 lg:py-32 bg-white overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="reveal-left">
          <span class="eyebrow mb-4">
            {t.presentation.subtitle}
          </span>
          <h2 class="section-title text-secondary-800 mb-6">
            {t.presentation.title}
          </h2>
          <div class="section-body text-secondary-600">
            <p set:html={t.presentation.p1} />
            <p set:html={t.presentation.p2} />
          </div>

          <!-- Train ticket -->
          <div class="mt-8 flex max-w-xl rounded-[20px] overflow-hidden border border-secondary-200 bg-secondary-50">
            <div class="flex w-12 shrink-0 items-center justify-center bg-primary-600 text-white" aria-hidden="true">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <rect x="5" y="3" width="14" height="14" rx="3"></rect>
                <path d="M5 10h14M9 14h.01M15 14h.01M8 21l1.5-4M16 21l-1.5-4"></path>
              </svg>
            </div>
            <dl class="grid flex-1 sm:grid-cols-3">
              {t.presentation.ticket.map((row, index) => (
                <div class={`px-5 py-4 ${index > 0 ? 'border-t border-dashed border-secondary-300 sm:border-t-0 sm:border-l' : ''}`}>
                  <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-secondary-600">{row.label}</dt>
                  <dd class={`mt-1 font-display font-bold leading-snug ${index === t.presentation.ticket.length - 1 ? 'text-accent-700' : 'text-secondary-800'}`}>{row.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#cap" class="btn-primary">
              {t.presentation.cta}
            </a>
            <a href="https://www.nousavonsdeselles.fr" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              {t.presentation.association}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Polaroids of the station -->
        <div class="reveal-right">
          <div class="relative isolate mx-auto aspect-square w-full max-w-xl">
            {t.presentation.photos.map((photo, index) => (
              <figure class={`absolute ${polaroidLayout[index]} bg-white p-2.5 pb-9 sm:p-3 sm:pb-11 shadow-[0_8px_24px_rgba(61,43,31,0.2)] transition-transform duration-500 hover:rotate-0 hover:scale-105 hover:z-20`}>
                <img
                  src={stationPhotos[index]}
                  alt={photo.alt}
                  class="w-full aspect-[4/3] object-cover"
                  loading="lazy"
                />
                <figcaption class="absolute inset-x-0 bottom-2 sm:bottom-3 text-center font-display italic text-sm sm:text-base text-secondary-600">
                  {photo.caption}
                </figcaption>
              </figure>
            ))}
            <div class="absolute -bottom-4 left-0 w-24 h-24 bg-primary-200 rounded-2xl -z-10"></div>
            <div class="absolute top-[14%] -right-3 w-16 h-16 bg-warm-200 rounded-xl -z-10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key figures Section -->
  <section id="enjeux" class="py-20 lg:py-28 bg-accent-400 overflow-hidden relative">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-24 left-1/4 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-24 right-1/4 w-80 h-80 bg-white/10 rounded-full blur-3xl"></div>
    </div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto mb-12 lg:mb-16 text-center reveal">
        <span class="eyebrow !text-secondary-800 mb-4">
          {t.stakes.subtitle}
        </span>
        <h2 class="section-title text-secondary-800">
          {t.stakes.title}
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6 lg:gap-8 stagger-children">
        {t.stakes.items.map((item) => (
          <div class="h-full rounded-[20px] bg-white p-8 shadow-[0_10px_30px_rgba(61,43,31,0.18)]">
            <span class="block w-10 h-1 mb-5 rounded-full bg-accent-400" aria-hidden="true"></span>
            <p class="font-display font-bold text-4xl lg:text-5xl leading-none text-primary-700">{item.value}</p>
            <p class="mt-4 text-secondary-700 leading-relaxed">{item.label}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-3xl mx-auto text-center text-xs italic leading-relaxed text-secondary-800 reveal">
        {t.stakes.sources}
      </p>
    </div>
  </section>

  <!-- Notre cap Section -->
  <section id="cap" class="py-20 lg:py-32 gradient-bg overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="reveal-left">
          <span class="eyebrow mb-4">
            {t.objectives.subtitle}
          </span>
          <h2 class="section-title text-secondary-800 mb-6">
            {t.objectives.title}
          </h2>
          <div class="section-body text-secondary-600">
            <p class="text-lg font-semibold text-secondary-800">{t.objectives.lead}</p>
            <p>{t.objectives.body}</p>
          </div>
        </div>

        <div class="reveal-right">
          <h3 class="font-sans text-sm font-semibold uppercase tracking-[0.08em] text-secondary-600 mb-5">
            {t.objectives.linesTitle}
          </h3>
          <div class="relative">
            <!-- Rail linking the three lines -->
            <span class="absolute left-[43px] top-10 bottom-10 border-l-2 border-dashed border-secondary-300" aria-hidden="true"></span>
            <ol class="space-y-4">
              {t.objectives.lines.map((line, index) => (
                <li class="card relative flex items-start gap-4 p-6">
                  <span class={`shrink-0 w-10 h-10 rounded-full ${lineColors[index]} text-white font-display font-bold text-lg flex items-center justify-center`} aria-hidden="true">
                    {index + 1}
                  </span>
                  <div>
                    <h4 class="font-display font-bold text-lg text-secondary-900 mb-1">{line.title}</h4>
                    <p class="text-secondary-600 leading-relaxed">{line.description}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>

      <div class="mt-20 lg:mt-28">
        <div class="max-w-3xl mx-auto mb-12 text-center reveal">
          <h3 class="font-display font-bold text-2xl lg:text-3xl text-secondary-800 mb-4">
            {t.objectives.goalsTitle}
          </h3>
          <p class="section-subtitle mx-auto">{t.objectives.description}</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 stagger-children">
          {t.objectives.items.map((objective, index) => (
            <ObjectiveCard
              title={objective.title}
              description={objective.description}
              icon={objectiveIcons[index]}
              color={objectiveColors[index]}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Le lieu Section -->
  <section id="lieu" class="py-20 lg:py-32 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle
        align="left"
        subtitle={t.activities.subtitle}
        title={t.activities.title}
        description={t.activities.description}
      />
      <ol class="border-t border-secondary-200 reveal">
        {t.activities.items.map((item, index) => (
          <PlatformRow
            number={index + 1}
            platformLabel={t.activities.platform}
            title={item.title}
            caption={'caption' in item ? item.caption : undefined}
            description={item.description}
            tags={item.tags}
            image={platformImages[index]}
          >
            <svg slot="icon" class="w-8 h-8 md:w-11 md:h-11 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </PlatformRow>
        ))}
      </ol>
    </div>
  </section>

  <!-- Publics Section -->
  <section id="publics" class="py-20 lg:py-32 bg-secondary-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle
        subtitle={t.publics.subtitle}
        title={t.publics.title}
        description={t.publics.description}
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 stagger-children">
        {t.publics.items.map((publicItem, index) => (
          <PublicCard
            title={publicItem.title}
            description={publicItem.description}
            icon={publicIcons[index]}
            color={publicColors[index]}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Bien vieillir Section -->
  <!-- TODO: intégrer les contenus complémentaires et documents de présentation transmis par l'association -->
  <section id="bien-vieillir" class="py-20 lg:py-32 bg-white overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="reveal-left">
          <span class="eyebrow mb-4">
            {t.ageing.subtitle}
          </span>
          <h2 class="section-title text-secondary-800 mb-6">
            {t.ageing.title}
          </h2>
          <div class="section-body text-secondary-600">
            <p>{t.ageing.p1}</p>
            <p>{t.ageing.p2}</p>
          </div>
        </div>
        <div class="reveal-right grid sm:grid-cols-2 gap-4">
          {t.ageing.pillars.map((pillar, index) => (
            <div class="rounded-2xl bg-secondary-50 p-6">
              <span class={`block w-8 h-1 rounded-full mb-4 ${['bg-primary-500', 'bg-accent-400', 'bg-warm-400', 'bg-primary-700'][index]}`}></span>
              <h3 class="font-display font-bold text-lg text-secondary-800 mb-2">{pillar.title}</h3>
              <p class="text-sm text-secondary-600 leading-relaxed">{pillar.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-16 lg:mt-20 reveal">
        <h3 class="text-center font-display font-bold text-2xl text-secondary-800 mb-8">
          {t.ageing.partnersTitle}
        </h3>
        <div class="grid md:grid-cols-3 gap-6">
          {t.ageing.partners.map((partner) => (
            <div class="rounded-2xl border border-secondary-200 p-6 text-center">
              <span class="block font-display font-bold text-lg text-primary-700 mb-2">{partner.name}</span>
              <p class="text-sm text-secondary-600 leading-relaxed">{partner.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Inclusion par l'emploi Section -->
  <section id="emploi" class="py-20 lg:py-32 bg-secondary-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-3 reveal-left">
          <span class="eyebrow mb-4">
            {t.employment.subtitle}
          </span>
          <h2 class="section-title text-secondary-800 mb-6">
            {t.employment.title}
          </h2>
          <div class="section-body text-secondary-600">
            <p>{t.employment.p1}</p>
            <p>{t.employment.p2}</p>
          </div>
          <p class="mt-8 mb-4 font-semibold text-secondary-800">{t.employment.factorsTitle}</p>
          <ul class="space-y-3">
            {t.employment.factors.map((factor) => (
              <li class="flex items-start gap-3 text-secondary-700">
                <svg class="w-5 h-5 mt-0.5 shrink-0 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>{factor}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="lg:col-span-2 reveal-right">
          <div class="rounded-[20px] bg-primary-600 text-white p-10 text-center shadow-[0_0_10px_rgba(0,0,0,0.2)]">
            <span class="block font-display font-bold text-7xl lg:text-8xl leading-none">{t.employment.goalValue}</span>
            <span class="block mt-3 text-xl font-display font-bold">{t.employment.goalLabel}</span>
            <p class="mt-4 text-primary-50 leading-relaxed">{t.employment.goalDescription}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ecological Approach Section -->
  <section class="py-20 lg:py-32 bg-primary-500 text-white overflow-hidden relative">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-0 right-0 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-white/5 rounded-full blur-3xl"></div>
    </div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="reveal-left">
          <span class="eyebrow !text-secondary-50 mb-4">
            {t.ecological.subtitle}
          </span>
          <h2 class="section-title mb-6 !text-secondary-50">
            {t.ecological.title}
          </h2>
          <div class="section-body text-white">
            <p>{t.ecological.p1}</p>
            <p>{t.ecological.p2}</p>
          </div>
        </div>
        <div class="reveal-right">
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-4">
              <div class="aspect-square rounded-2xl bg-white/10 backdrop-blur-sm flex items-center justify-center p-6">
                <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
              </div>
              <div class="aspect-[4/3] rounded-2xl bg-white/10 backdrop-blur-sm flex items-center justify-center p-6">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
              </div>
            </div>
            <div class="space-y-4 pt-8">
              <div class="aspect-[4/3] rounded-2xl bg-white/10 backdrop-blur-sm flex items-center justify-center p-6">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                </svg>
              </div>
              <div class="aspect-square rounded-2xl bg-white/10 backdrop-blur-sm flex items-center justify-center p-6">
                <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-20 lg:py-32 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle
        subtitle={t.testimonials.subtitle}
        title={t.testimonials.title}
        description={t.testimonials.description}
      />
      <div class="grid md:grid-cols-3 gap-6 lg:gap-8 stagger-children">
        {t.testimonials.items.map((testimonial) => (
          <TestimonialCard
            quote={testimonial.quote}
            author={testimonial.author}
            role={testimonial.role}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Partners Section -->
  <section id="partenaires" class="py-20 lg:py-32 bg-secondary-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle
        subtitle={t.partners.subtitle}
        title={t.partners.title}
        description={t.partners.description}
      />
      <PartnerGrid partners={partners} />
      <div class="text-center mt-12 reveal">
        <a href="#contact" class="btn-secondary">
          {t.partners.cta}
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-20 lg:py-32 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle
        subtitle={t.gallery.subtitle}
        title={t.gallery.title}
        description={t.gallery.description}
      />
      <Gallery items={galleryItems} />
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 lg:py-32 bg-secondary-800 overflow-hidden relative">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-white/5 rounded-full blur-3xl"></div>
    </div>
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center relative z-10 reveal">
      <h2 class="section-title mx-auto mb-6 !text-white">
        {t.cta.title}
      </h2>
      <p class="text-xl text-secondary-200 mb-10 max-w-2xl mx-auto">
        {t.cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact" class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-primary-500 rounded-full transition-all duration-300 hover:bg-primary-600 hover:shadow-xl hover:-translate-y-1">
          {t.cta.primary}
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a href="https://www.nousavonsdeselles.fr" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white border-2 border-white/30 rounded-full transition-all duration-300 hover:bg-white/10 hover:border-white">
          {t.cta.secondary}
        </a>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-20 lg:py-32 bg-secondary-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle
        subtitle={t.contact.subtitle}
        title={t.contact.title}
        description={t.contact.info.description}
      />
      <ContactSection
        email="nadira@nousavonsdeselles.fr"
        lang={lang}
      />
    </div>
  </section>
</MainLayout>
