---
import MainLayout from '../layouts/MainLayout.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<MainLayout
  title="Politique de confidentialité | Station-Cœur"
  description="Politique de confidentialité du site Station-Cœur, projet porté par l'association Nous Avons Des Elles."
>
  <section class="pt-32 pb-20 lg:pb-32">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h1 class="section-title text-secondary-900 mb-8">{t.privacy.title}</h1>

      <div class="prose prose-lg prose-secondary max-w-none">
        <p class="text-lg text-secondary-700">
          L'association Nous Avons Des Elles s'engage à protéger la vie privée des utilisateurs
          de son site Station-Cœur. Cette politique de confidentialité explique comment nous
          collectons, utilisons et protégeons vos données personnelles.
        </p>

        <h2>Données collectées</h2>
        <p>
          Nous collectons uniquement les données que vous nous transmettez volontairement
          via notre formulaire de contact :
        </p>
        <ul>
          <li>Nom et prénom</li>
          <li>Adresse email</li>
          <li>Organisation (facultatif)</li>
          <li>Message</li>
        </ul>

        <h2>Utilisation des données</h2>
        <p>
          Vos données sont utilisées exclusivement pour :
        </p>
        <ul>
          <li>Répondre à vos demandes de contact</li>
          <li>Vous informer sur les activités de Station-Cœur (avec votre consentement)</li>
        </ul>

        <h2>Conservation des données</h2>
        <p>
          Vos données sont conservées pendant une durée maximale de 3 ans à compter
          de votre dernier contact, sauf obligation légale contraire.
        </p>

        <h2>Partage des données</h2>
        <p>
          Nous ne vendons, n'échangeons ni ne transférons vos données personnelles
          à des tiers sans votre consentement explicite, sauf obligation légale.
        </p>

        <h2>Vos droits</h2>
        <p>
          Conformément au RGPD, vous disposez des droits suivants :
        </p>
        <ul>
          <li><strong>Droit d'accès</strong> : obtenir une copie de vos données</li>
          <li><strong>Droit de rectification</strong> : corriger vos données</li>
          <li><strong>Droit à l'effacement</strong> : supprimer vos données</li>
          <li><strong>Droit à la portabilité</strong> : récupérer vos données</li>
          <li><strong>Droit d'opposition</strong> : refuser certains traitements</li>
        </ul>

        <h2>Sécurité</h2>
        <p>
          Nous mettons en œuvre des mesures de sécurité appropriées pour protéger
          vos données contre tout accès non autorisé, modification ou divulgation.
        </p>

        <h2>Contact</h2>
        <p>
          Pour toute question concernant cette politique ou pour exercer vos droits,
          contactez-nous à : <a href="mailto:nadira@nousavonsdeselles.fr" class="text-primary-600 hover:text-primary-700">nadira@nousavonsdeselles.fr</a>
        </p>

        <p class="text-sm text-secondary-500 mt-8">
          Dernière mise à jour : Octobre 2026
        </p>
      </div>

      <div class="mt-12">
        <a href={getLocalizedPath('/', lang)} class="btn-secondary">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          {t.privacy.back}
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .prose h2 {
    @apply text-xl font-display font-bold text-secondary-900 mt-8 mb-4;
  }

  .prose p {
    @apply text-secondary-600 mb-4 leading-relaxed;
  }

  .prose ul {
    @apply text-secondary-600 mb-4 ml-6 space-y-2;
  }

  .prose li {
    @apply list-disc;
  }
</style>
