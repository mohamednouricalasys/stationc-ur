---
interface Props {
  title: string;
  description: string;
  icon: string;
  color?: 'primary' | 'accent' | 'warm' | 'secondary';
}

const { title, description, icon, color = 'primary' } = Astro.props;

const colorClasses = {
  primary: {
    bg: 'bg-primary-100',
    icon: 'text-primary-600',
    hover: 'group-hover:bg-primary-500',
    border: 'border-primary-100 hover:border-primary-200'
  },
  accent: {
    bg: 'bg-accent-100',
    icon: 'text-accent-600',
    hover: 'group-hover:bg-accent-500',
    border: 'border-accent-100 hover:border-accent-200'
  },
  warm: {
    bg: 'bg-warm-100',
    icon: 'text-warm-600',
    hover: 'group-hover:bg-warm-500',
    border: 'border-warm-100 hover:border-warm-200'
  },
  secondary: {
    bg: 'bg-secondary-100',
    icon: 'text-secondary-600',
    hover: 'group-hover:bg-secondary-500',
    border: 'border-secondary-100 hover:border-secondary-200'
  }
};

const colors = colorClasses[color];
---

<div class={`group card h-full p-8 border-2 ${colors.border} transition-all duration-300`}>
  <div class={`w-14 h-14 ${colors.bg} rounded-2xl flex items-center justify-center mb-6 transition-all duration-300 ${colors.hover} group-hover:scale-110 [&_svg]:transition-colors group-hover:[&_svg]:text-white`}>
    <Fragment set:html={icon} />
  </div>
  <h3 class="text-xl font-display font-bold text-secondary-900 mb-3 group-hover:text-primary-600 transition-colors">
    {title}
  </h3>
  <p class="text-secondary-600 leading-relaxed">
    {description}
  </p>
</div>
