---
import { useTranslations, type Language } from '../i18n';

interface Props {
  email?: string;
  phone?: string;
  address?: string;
  lang?: Language;
}

const {
  email = "contact@nousavonsdeselles.fr",
  phone = "",
  address = "",
  lang = 'fr'
} = Astro.props;

const t = useTranslations(lang);
---

<div class="max-w-3xl mx-auto text-center">
  <div class="flex flex-wrap justify-center gap-6 mb-12">
    {email && (
      <a
        href={`mailto:${email}`}
        class="group flex flex-col items-center w-full sm:w-80 p-6 bg-white rounded-2xl border border-secondary-100 transition-all duration-300 hover:border-primary-200 hover:shadow-lg hover:-translate-y-1"
      >
        <div class="w-14 h-14 bg-primary-100 rounded-xl flex items-center justify-center mb-4 transition-all duration-300 group-hover:bg-primary-500 group-hover:scale-110">
          <svg class="w-6 h-6 text-primary-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <span class="text-sm text-secondary-500 mb-1">{t.contact.info.email}</span>
        <span class="text-secondary-900 font-medium break-all group-hover:text-primary-600 transition-colors">{email}</span>
      </a>
    )}

    {phone && (
      <a
        href={`tel:${phone.replace(/\s/g, '')}`}
        class="group flex flex-col items-center w-full sm:w-80 p-6 bg-white rounded-2xl border border-secondary-100 transition-all duration-300 hover:border-accent-200 hover:shadow-lg hover:-translate-y-1"
      >
        <div class="w-14 h-14 bg-accent-100 rounded-xl flex items-center justify-center mb-4 transition-all duration-300 group-hover:bg-accent-500 group-hover:scale-110">
          <svg class="w-6 h-6 text-accent-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
        </div>
        <span class="text-sm text-secondary-500 mb-1">{t.contact.info.phone}</span>
        <span class="text-secondary-900 font-medium group-hover:text-accent-600 transition-colors">{phone}</span>
      </a>
    )}

    {address && (
      <div class="group flex flex-col items-center w-full sm:w-80 p-6 bg-white rounded-2xl border border-secondary-100">
        <div class="w-14 h-14 bg-warm-100 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-warm-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </div>
        <span class="text-sm text-secondary-500 mb-1">{t.contact.info.address}</span>
        <span class="text-secondary-900 font-medium text-center">{address}</span>
      </div>
    )}
  </div>

  <!-- Social Links -->
  <div class="pt-8 border-t border-secondary-200">
    <p class="text-sm text-secondary-500 mb-6">{t.contact.info.social}</p>
    <div class="flex items-center justify-center gap-4">
      <a
        href="https://www.linkedin.com/company/nous-avons-des-elles"
        target="_blank"
        rel="noopener noreferrer"
        class="w-12 h-12 flex items-center justify-center rounded-full bg-white border border-secondary-200 text-secondary-600 transition-all duration-300 hover:bg-primary-500 hover:border-primary-500 hover:text-white hover:scale-110"
        aria-label="LinkedIn"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>
      <a
        href="https://www.facebook.com/nousavonsdeselles"
        target="_blank"
        rel="noopener noreferrer"
        class="w-12 h-12 flex items-center justify-center rounded-full bg-white border border-secondary-200 text-secondary-600 transition-all duration-300 hover:bg-primary-500 hover:border-primary-500 hover:text-white hover:scale-110"
        aria-label="Facebook"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/>
        </svg>
      </a>
      <a
        href="https://www.instagram.com/nousavonsdeselles"
        target="_blank"
        rel="noopener noreferrer"
        class="w-12 h-12 flex items-center justify-center rounded-full bg-white border border-secondary-200 text-secondary-600 transition-all duration-300 hover:bg-primary-500 hover:border-primary-500 hover:text-white hover:scale-110"
        aria-label="Instagram"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- CTA Button -->
  <div class="mt-10">
    <a
      href={`mailto:${email}`}
      class="btn-primary inline-flex"
    >
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
      </svg>
      {t.contact.cta}
    </a>
  </div>
</div>
