---
interface Partner {
  name: string;
  logo?: string;
  url?: string;
}

interface Props {
  partners: Partner[];
}

const { partners } = Astro.props;
---

<div class="flex flex-wrap justify-center gap-4 sm:gap-6 lg:gap-8">
  {partners.map((partner, index) => (
    <div
      class="reveal-scale group w-[calc(50%-0.5rem)] sm:w-48"
      style={`transition-delay: ${index * 100}ms`}
    >
      {partner.url ? (
        <a
          href={partner.url}
          target="_blank"
          rel="noopener noreferrer"
          class="block bg-white rounded-2xl p-6 border border-secondary-100 transition-all duration-300 hover:border-primary-200 hover:shadow-lg hover:-translate-y-1"
          title={partner.name}
        >
          {partner.logo ? (
            <img
              src={partner.logo}
              alt={partner.name}
              class="w-full h-16 object-contain grayscale opacity-60 transition-all duration-300 group-hover:grayscale-0 group-hover:opacity-100"
              loading="lazy"
            />
          ) : (
            <div class="h-16 flex items-center justify-center">
              <span class="text-sm font-medium text-secondary-400 text-center group-hover:text-secondary-600 transition-colors">
                {partner.name}
              </span>
            </div>
          )}
        </a>
      ) : (
        <div class="bg-white rounded-2xl p-6 border border-secondary-100 transition-all duration-300 hover:border-primary-200 hover:shadow-lg">
          {partner.logo ? (
            <img
              src={partner.logo}
              alt={partner.name}
              class="w-full h-16 object-contain grayscale opacity-60 transition-all duration-300 group-hover:grayscale-0 group-hover:opacity-100"
              loading="lazy"
            />
          ) : (
            <div class="h-16 flex items-center justify-center">
              <span class="text-sm font-medium text-secondary-400 text-center">
                {partner.name}
              </span>
            </div>
          )}
        </div>
      )}
    </div>
  ))}
</div>
