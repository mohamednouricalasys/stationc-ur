---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Anchors must point back to the home page when rendered on secondary pages
const homePath = getLocalizedPath('/', lang);
const isHome = Astro.url.pathname.replace(/\/$/, '') === homePath.replace(/\/$/, '');
const anchor = (id: string) => (isHome ? `#${id}` : `${homePath}#${id}`);
const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: anchor('presentation'), label: t.nav.project },
  { href: anchor('objectifs'), label: t.nav.objectives },
  { href: anchor('activites'), label: t.nav.activities },
  { href: anchor('contact'), label: t.nav.contact },
];

const externalLinks = [
  { href: 'https://www.nousavonsdeselles.fr', label: 'Nous Avons Des Elles' },
  { href: 'https://www.nousavonsdeselles.fr/les-precieuses', label: 'Les Précieuses' },
];
---

<footer class="bg-secondary-900 text-white">
  <!-- Main Footer -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-6">
          <picture class="block bg-cream rounded-[20px] px-4 py-3">
            <source
              type="image/webp"
              srcset={`${base}/images/logo/logo-station-coeur-320.webp 320w, ${base}/images/logo/logo-station-coeur-640.webp 640w`}
              sizes="180px"
            />
            <img
              src={`${base}/images/logo/logo-station-coeur-320.png`}
              srcset={`${base}/images/logo/logo-station-coeur-320.png 320w, ${base}/images/logo/logo-station-coeur-640.png 640w`}
              sizes="180px"
              alt="Station-Cœur"
              width="320"
              height="157"
              class="w-[180px] h-auto"
              loading="lazy"
            />
          </picture>
          <span class="text-sm text-secondary-400">Nous Avons Des Elles</span>
        </div>
        <p class="text-secondary-300 max-w-md mb-6 leading-relaxed">
          {t.footer.description}
        </p>
        <!-- Social Links -->
        <div class="flex items-center gap-4">
          <a
            href="https://www.linkedin.com/company/nous-avons-des-elles"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 flex items-center justify-center rounded-full bg-secondary-800 text-secondary-300 transition-all duration-300 hover:bg-primary-500 hover:text-white hover:scale-110"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a
            href="https://www.facebook.com/nousavonsdeselles"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 flex items-center justify-center rounded-full bg-secondary-800 text-secondary-300 transition-all duration-300 hover:bg-primary-500 hover:text-white hover:scale-110"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/nousavonsdeselles"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 flex items-center justify-center rounded-full bg-secondary-800 text-secondary-300 transition-all duration-300 hover:bg-primary-500 hover:text-white hover:scale-110"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-secondary-400 mb-6">
          {t.footer.navigation}
        </h3>
        <ul class="space-y-3">
          {quickLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="text-secondary-300 transition-colors duration-200 hover:text-primary-400"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- External Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-secondary-400 mb-6">
          {t.footer.association}
        </h3>
        <ul class="space-y-3">
          {externalLinks.map(link => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-secondary-300 transition-colors duration-200 hover:text-primary-400 inline-flex items-center gap-1"
              >
                {link.label}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-secondary-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
        <p class="text-secondary-400 text-sm">
          &copy; {currentYear} Nous Avons Des Elles. {t.footer.rights}
        </p>
        <div class="flex items-center gap-6 text-sm">
          <a href={getLocalizedPath('mentions-legales', lang)} class="text-secondary-400 hover:text-primary-400 transition-colors">
            {t.footer.legal}
          </a>
          <a href={getLocalizedPath('politique-confidentialite', lang)} class="text-secondary-400 hover:text-primary-400 transition-colors">
            {t.footer.privacy}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
