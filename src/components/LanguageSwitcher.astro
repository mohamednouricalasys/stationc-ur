---
import { languages, getLangFromUrl, getLocalizedPath, getCurrentPath, type Language } from '../i18n';

const currentLang = getLangFromUrl(Astro.url);
const currentPath = getCurrentPath(Astro.url, currentLang);
---

<div class="relative" data-lang-switcher>
  <button
    type="button"
    class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-secondary-600 rounded-lg transition-colors hover:text-primary-600 hover:bg-primary-50"
    aria-label="Change language"
    aria-expanded="false"
    data-lang-button
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
    </svg>
    <span class="uppercase">{currentLang}</span>
    <svg class="w-3 h-3 transition-transform" data-lang-chevron fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div
    data-lang-dropdown
    class="absolute right-0 mt-2 w-36 bg-white rounded-xl shadow-lg shadow-secondary-900/10 border border-secondary-100 py-2 hidden z-50"
  >
    {Object.entries(languages).map(([lang, label]) => (
      <a
        href={getLocalizedPath(currentPath, lang as Language)}
        class:list={[
          'flex items-center gap-2 px-4 py-2 text-sm transition-colors',
          lang === currentLang
            ? 'text-primary-600 bg-primary-50 font-medium'
            : 'text-secondary-600 hover:text-primary-600 hover:bg-primary-50',
        ]}
      >
        {lang === currentLang && (
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        )}
        <span class:list={[lang !== currentLang && 'ml-6']}>{label}</span>
      </a>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang-switcher]').forEach((switcher) => {
    const button = switcher.querySelector<HTMLButtonElement>('[data-lang-button]');
    const dropdown = switcher.querySelector<HTMLElement>('[data-lang-dropdown]');
    const chevron = switcher.querySelector<SVGElement>('[data-lang-chevron]');

    const setOpen = (open: boolean) => {
      dropdown?.classList.toggle('hidden', !open);
      chevron?.classList.toggle('rotate-180', open);
      button?.setAttribute('aria-expanded', String(open));
    };

    button?.addEventListener('click', () => {
      setOpen(dropdown?.classList.contains('hidden') ?? false);
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!switcher.contains(e.target as Node)) setOpen(false);
    });

    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  });
</script>
