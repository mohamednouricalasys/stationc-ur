---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Anchors must point back to the home page when rendered on secondary pages
const homePath = getLocalizedPath('/', lang);
const isHome = Astro.url.pathname.replace(/\/$/, '') === homePath.replace(/\/$/, '');
const anchor = (id: string) => (isHome ? `#${id}` : `${homePath}#${id}`);

const navLinks = [
  { href: anchor('presentation'), label: t.nav.project },
  { href: anchor('objectifs'), label: t.nav.objectives },
  { href: anchor('activites'), label: t.nav.activities },
  { href: anchor('publics'), label: t.nav.publics },
  { href: anchor('partenaires'), label: t.nav.partners },
  { href: anchor('contact'), label: t.nav.contact },
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="header">
  <!-- Go-back link to the association website -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="border-b border-secondary-300/40">
      <a
        href="https://www.nousavonsdeselles.fr/"
        class="group inline-flex items-center gap-1.5 py-1 text-[11px] tracking-wide text-secondary-500 transition-colors hover:text-primary-600"
      >
        <svg class="w-3 h-3 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        {t.nav.backToAssociation}
      </a>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between py-1.5">
      <!-- Logo -->
      <a href={getLocalizedPath('/', lang)} class="flex items-center gap-3 group">
        <picture>
          <source
            type="image/webp"
            srcset={`${base}/images/logo/logo-station-coeur-320.webp 320w, ${base}/images/logo/logo-station-coeur-640.webp 640w`}
            sizes="(min-width: 640px) 100px, 92px"
          />
          <img
            src={`${base}/images/logo/logo-station-coeur-320.png`}
            srcset={`${base}/images/logo/logo-station-coeur-320.png 320w, ${base}/images/logo/logo-station-coeur-640.png 640w`}
            sizes="(min-width: 640px) 100px, 92px"
            alt="Station-Cœur"
            width="320"
            height="157"
            class="h-11 sm:h-12 w-auto transition-opacity duration-300 group-hover:opacity-80"
            fetchpriority="high"
          />
        </picture>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-0.5 xl:gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="px-3 xl:px-3.5 py-1.5 text-sm text-secondary-700 transition-colors duration-200 hover:text-primary-700"
          >
            {link.label}
          </a>
        ))}
        <div class="ml-2 border-l border-secondary-300/60 pl-2">
          <LanguageSwitcher />
        </div>
        <a href={anchor('contact')} class="btn-primary ml-4 px-5 py-2 text-sm font-medium hover:shadow-none hover:translate-y-0 hidden xl:inline-flex">
          {t.nav.joinAdventure}
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="lg:hidden flex items-center gap-2">
        <LanguageSwitcher />
        <button
          type="button"
          class="relative w-9 h-9 flex items-center justify-center rounded-lg text-secondary-700 transition-colors hover:bg-secondary-200/60"
          id="mobile-menu-button"
          aria-label="Menu"
          aria-expanded="false"
        >
          <svg class="w-5 h-5 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg class="w-5 h-5 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Navigation -->
    <div class="lg:hidden hidden" id="mobile-menu">
      <div class="py-3 space-y-1 border-t border-secondary-300/40">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="block px-4 py-2.5 text-base text-secondary-700 rounded-lg transition-colors hover:bg-secondary-200/50 hover:text-primary-700"
          >
            {link.label}
          </a>
        ))}
        <div class="pt-4">
          <a href={anchor('contact')} class="btn-primary w-full text-center">
            {t.nav.joinAdventure}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  header {
    background: rgba(244, 235, 223, 0.96); /* beige #F4EBDF */
    border-bottom: 1px solid rgba(61, 43, 31, 0.06);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  header.scrolled {
    box-shadow: 0 2px 12px rgba(61, 43, 31, 0.06);
  }
</style>

<script>
  const header = document.getElementById('header');
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = mobileMenuButton?.querySelector('.menu-icon');
  const closeIcon = mobileMenuButton?.querySelector('.close-icon');

  // Scroll effect
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    if (currentScroll > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }

    lastScroll = currentScroll;
  });

  // Mobile menu toggle
  mobileMenuButton?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden');

    if (isOpen) {
      mobileMenu?.classList.remove('hidden');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      mobileMenuButton.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuButton.setAttribute('aria-expanded', 'false');
    }
  });

  // Close mobile menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
