---
interface Props {
  title: string;
  description: string;
  icon: string;
  color?: 'primary' | 'accent' | 'warm' | 'secondary';
}

const { title, description, icon, color = 'primary' } = Astro.props;

const colorClasses = {
  primary: {
    bg: 'from-primary-500 to-primary-600',
    shadow: 'shadow-primary-500/30'
  },
  accent: {
    bg: 'from-accent-500 to-accent-600',
    shadow: 'shadow-accent-500/30'
  },
  warm: {
    bg: 'from-warm-500 to-warm-600',
    shadow: 'shadow-warm-500/30'
  },
  secondary: {
    bg: 'from-secondary-500 to-secondary-600',
    shadow: 'shadow-secondary-500/30'
  }
};

const colors = colorClasses[color];
---

<div class="group text-center">
  <div class={`w-20 h-20 mx-auto mb-6 bg-gradient-to-br ${colors.bg} rounded-2xl flex items-center justify-center shadow-lg ${colors.shadow} transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3`}>
    <Fragment set:html={icon} />
  </div>
  <h3 class="text-xl font-display font-bold text-secondary-900 mb-3">
    {title}
  </h3>
  <p class="text-secondary-600 leading-relaxed max-w-sm mx-auto">
    {description}
  </p>
</div>
