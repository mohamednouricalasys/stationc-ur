---
import { useTranslations, type Language } from '../i18n';

interface Props {
  lang?: Language;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-primary-50 via-white to-accent-50">
  <!-- Background decorations -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- Gradient orbs -->
    <div class="absolute top-1/4 -left-20 w-96 h-96 bg-primary-200/30 rounded-full blur-3xl animate-pulse-soft"></div>
    <div class="absolute bottom-1/4 -right-20 w-80 h-80 bg-accent-200/30 rounded-full blur-3xl animate-pulse-soft animate-delay-500"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-warm-100/20 rounded-full blur-3xl"></div>

    <!-- Floating shapes -->
    <div class="absolute top-20 right-1/4 w-4 h-4 bg-primary-400 rounded-full animate-float opacity-60"></div>
    <div class="absolute top-1/3 left-1/4 w-3 h-3 bg-accent-400 rounded-full animate-float animate-delay-200 opacity-60"></div>
    <div class="absolute bottom-1/3 right-1/3 w-5 h-5 bg-warm-400 rounded-full animate-float animate-delay-400 opacity-60"></div>

    <!-- Grid pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:60px_60px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-32 lg:py-40">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Content -->
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 backdrop-blur-sm rounded-full border border-primary-100 shadow-sm mb-8 animate-fade-in">
          <span class="w-2 h-2 bg-primary-500 rounded-full animate-pulse"></span>
          <span class="text-sm font-medium text-secondary-600">{t.hero.badge}</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-display font-bold leading-tight mb-6 animate-fade-in-up">
          <span class="gradient-text">{t.hero.title}</span>
        </h1>

        <p class="text-xl sm:text-2xl lg:text-3xl font-display font-medium text-secondary-700 mb-6 animate-fade-in-up animate-delay-100 text-balance">
          {t.hero.subtitle}
        </p>

        <p class="text-lg text-secondary-600 max-w-xl mx-auto lg:mx-0 mb-10 animate-fade-in-up animate-delay-200 leading-relaxed">
          {t.hero.description}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start animate-fade-in-up animate-delay-300">
          <a href="#presentation" class="btn-primary group">
            {t.hero.primaryCta}
            <svg class="w-5 h-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a href="#contact" class="btn-secondary">
            {t.hero.secondaryCta}
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 mt-12 pt-10 border-t border-secondary-200 animate-fade-in-up animate-delay-400">
          <div class="text-center lg:text-left">
            <span class="block text-3xl lg:text-4xl font-display font-bold text-primary-600">6+</span>
            <span class="text-sm text-secondary-500">{t.hero.stats.years}</span>
          </div>
          <div class="text-center lg:text-left">
            <span class="block text-3xl lg:text-4xl font-display font-bold text-accent-600">100+</span>
            <span class="text-sm text-secondary-500">{t.hero.stats.beneficiaries}</span>
          </div>
          <div class="text-center lg:text-left">
            <span class="block text-3xl lg:text-4xl font-display font-bold text-warm-600">10+</span>
            <span class="text-sm text-secondary-500">{t.hero.stats.partners}</span>
          </div>
        </div>
      </div>

      <!-- Visual -->
      <div class="relative lg:pl-8 animate-fade-in-up animate-delay-200">
        <div class="relative">
          <!-- Main image container -->
          <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-secondary-900/20">
            <img
              src="/images/activities/activity-10.webp"
              alt={lang === 'fr' ? "La gare qui accueille Station-Cœur" : "The station that hosts Station-Cœur"}
              class="w-full aspect-[4/3] object-cover"
              fetchpriority="high"
            />
            <!-- Overlay gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-secondary-900/20 to-transparent"></div>
          </div>

          <!-- Floating cards -->
          <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl p-4 shadow-xl shadow-secondary-900/10 animate-float hidden sm:block">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-accent-100 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <div>
                <span class="block text-sm font-semibold text-secondary-900">{t.misc.solidarity}</span>
                <span class="text-xs text-secondary-500">{t.misc.localHelp}</span>
              </div>
            </div>
          </div>

          <div class="absolute -top-4 -right-4 bg-white rounded-2xl p-4 shadow-xl shadow-secondary-900/10 animate-float animate-delay-300 hidden sm:block">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-primary-100 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div>
                <span class="block text-sm font-semibold text-secondary-900">{t.misc.inclusion}</span>
                <span class="text-xs text-secondary-500">{t.misc.forAll}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <a href="#presentation" class="flex flex-col items-center gap-2 text-secondary-400 hover:text-primary-500 transition-colors">
      <span class="text-xs font-medium">{t.hero.scrollLabel}</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </a>
  </div>
</section>
